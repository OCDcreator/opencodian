#!/bin/sh
# pre-push hook (Phase 2 Task 9).
#
# Runs the same architecture gates and scope as local verify and CI. The base
# ref resolves to origin/main (the merge gate also runs in protected CI).

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

VERIFY_BASE_REF=origin/main npm run verify:architecture
