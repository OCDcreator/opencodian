{
  "name": "opencodian",
  "version": "1.1.2",
  "description": "OpenCodian - OpenCode AI embedded in Obsidian sidebar",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/patch-unrs-resolver.mjs",
    "build:css": "node scripts/build-css.mjs",
    "deploy:windows:math": "bash scripts/deploy-windows-math-vault.sh",
    "package:plugin": "node scripts/package-plugin-artifact.mjs",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "node scripts/build.mjs production",
    "sync:lobehub-icons": "node scripts/sync-lobehub-icons.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "doctor:esbuild": "node scripts/doctor-esbuild.mjs",
    "doctor:esbuild:fix": "node scripts/doctor-esbuild.mjs --fix",
    "graphify:update:src": "node scripts/update-graphify-src.mjs",
    "check:owner-guard": "node scripts/check-owner-guard.mjs",
    "check:graphify": "node scripts/check-graphify-freshness.mjs",
    "check:devlog-order": "node scripts/check-devlog-order.mjs",
    "check:module-docs:coverage": "node scripts/check-module-doc-coverage.mjs",
    "check:module-docs:diff": "node scripts/check-module-doc-diff.mjs --range HEAD",
    "check:module-docs": "npm run check:module-docs:coverage && npm run check:module-docs:diff",
    "list:module-docs": "node scripts/list-module-doc-targets-from-diff.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "verify": "npm run check:owner-guard && npm run check:module-docs && npm run check:graphify && npm run check:devlog-order && npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node scripts/run-jest.js",
    "test:watch": "node scripts/run-jest.js --watch",
    "test:coverage": "node scripts/run-jest.js --coverage",
    "hooks:install": "node scripts/install-hooks.mjs",
    "version": "node scripts/sync-version.js && git add manifest.json versions.json",
    "impeccable": "impeccable",
    "impeccable:detect": "impeccable detect",
    "impeccable:skills": "impeccable skills"
  },
  "keywords": [
    "opencode",
    "ai",
    "obsidian",
    "obsidian-plugin",
    "productivity"
  ],
  "author": "OpenCodian Team",
  "license": "MIT",
  "devDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "@lobehub/icons": "5.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.27.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "impeccable": "^2.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.145",
    "@openai/codex-sdk": "0.139.0",
    "@opencode-ai/sdk": "1.18.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.3.1",
    "tslib": "^2.8.1",
    "ws": "^8.20.0"
  }
}
